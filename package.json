{
  "name": "red-alert-command",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "npm run lint -- --fix",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "check": "npm run lint && npm run fmt:check && npm test && npm run build"
  },
  "dependencies": {
    "7z-wasm": "^1.2.0",
    "egoroof-blowfish": "^4.0.3",
    "fflate": "^0.8.2",
    "smol-toml": "^1.3.1"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.83.0",
    "@types/node": "^22.0.0",
    "fake-indexeddb": "^6.2.5",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^4.1.11",
    "wrangler": "4.131.1"
  }
}
